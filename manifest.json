{
  "manifest_version": 2,
  "name": "Claude Sidebar",
  "version": "0.6.0",
  "description": "Private Claude-Sidebar für Zen/Firefox: Recherche mit Websuche, Produktvergleiche, Bilder, Tabs und Ordner aufräumen. Eigener API-Key, Verlauf nur lokal.",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-sidebar@louis.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "browsingActivity"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/louisdotxyz/zen-claude-sidebar/main/updates.json"
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "menus",
    "theme",
    "storage",
    "unlimitedStorage",
    "<all_urls>"
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "background": {
    "scripts": [
      "sidebar/i18n.js",
      "background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "Claude",
    "default_panel": "sidebar/panel.html",
    "default_icon": "icons/icon.svg",
    "open_at_install": false
  },
  "commands": {
    "toggle-claude": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Claude ein-/ausblenden"
    },
    "_execute_sidebar_action": {
      "description": "Claude als Seitenleiste öffnen/schliessen"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content/float.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "sidebar/panel.html"
  ]
}
